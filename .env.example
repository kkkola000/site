# ---- Сервер ----
PORT=3000
HOST=0.0.0.0

# Базовая авторизация панели (если пусто — панель открыта без пароля)
AUTH_USER=manager
AUTH_PASSWORD=

# ---- Яндекс Доставка: «Доставка в другой день» ----
# Боевой хост Яндекс Доставки
YANDEX_API_BASE=https://b2b-authproxy.taxi.yandex.net
# OAuth-токен: dostavka.yandex.ru/account2/integration → «Получить токен».
# Передаётся как Authorization: Bearer <токен>. Обязателен.
YANDEX_OAUTH_TOKEN=
# Необязательно: показывать только заказы с этих складов отгрузки (platform_station_id через запятую)
YANDEX_STATION_IDS=

# Сети, которым nginx открывает панель (заполняется скриптом развёртывания).
# Сеть туннеля WireGuard, например: 10.66.66.0/24
ALLOW_SUBNETS=

# ---- Данные ----
# За сколько дней назад запрашивать заказы
ORDERS_LOOKBACK_DAYS=60
# Максимум заказов в выборке
ORDERS_LIMIT=500
# TTL кэша ответов API, секунды
CACHE_TTL_SECONDS=60
# Таймаут запроса к API, мс
REQUEST_TIMEOUT_MS=15000
# Делитель цены: в API суммы приходят в копейках
PRICE_DIVISOR=100
# Валюта для отображения
CURRENCY=RUB
